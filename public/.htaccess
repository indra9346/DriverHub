# Apache / LiteSpeed (cPanel) settings for the Driver Hub build (dist/).
# Upload the whole dist/ folder, including this file, to the site's web root.

Options -MultiViews
RewriteEngine On
RewriteBase /
# Real files (scripts, images, manifest) are served as they are; every other
# address is a page of the app.
RewriteCond %{REQUEST_FILENAME} !-f
# A missing script from an older upload stays a 404 instead of becoming a page.
RewriteCond %{REQUEST_URI} !^/assets/
RewriteRule ^ index.html [L]

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Always check for a new version of the page, the service worker and the
  # manifest, so a new upload is live on the next visit.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Built scripts and styles have a content hash in their name: cache for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
