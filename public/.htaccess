<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve existing files, directories, and symbolic links (assets, images, logos, banners)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # A missing script from an older upload stays a 404 instead of becoming a page
  RewriteRule ^assets/ - [R=404,L]

  # Rewrite all SPA routes (e.g. /jobs, /jobs?category=HMV, /employer/post-job) to /index.html
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Fallback if mod_rewrite is disabled on the server
ErrorDocument 404 /index.html

# Web app manifest ("Download App" on phones)
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Always check for a new version of the page, the service worker and the
  # manifest, so a new upload is live on the next visit.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Built scripts and styles have a content hash in their name: cache for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
